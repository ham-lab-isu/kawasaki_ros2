<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format2.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>khi_cx165l_support</name>
  <version>0.0.0</version>
  <description>
    <p>Iowa State University support for the Kawasaki cx165l (and variants).</p>
    <p>
      This package contains configuration data, 3D models and launch files
      for the kawasaki cx165l manipulator.
    </p>
    <p>
      <b>Specifications</b>
    </p>
    <ul>
      <li>CX165L - Default</li>
    </ul>
  </description>

  <author email="walterg@iastate.edu">Walter Glockner</author>
  <maintainer email="walterg@iatate.edu">Walter Glockner</maintainer>

  <license>BSD</license>

  <url type="repository">https://github.com/ham-lab-isu/kawasaki_ros2</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>khi_resources</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <!-- <architecture_independent/> -->
  </export>
</package>
